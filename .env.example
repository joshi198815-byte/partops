# ---------- Base de datos ----------
# Runtime: rol SIN privilegios de dueño, para que RLS aplique siempre.
DATABASE_URL="postgresql://partops_app:partops_app@localhost:5432/partops"
# Migraciones: rol dueño.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/partops"

# ---------- API ----------
PORT=4000
API_PUBLIC_URL="http://localhost:4000"
WEB_APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# Better Auth (generar con: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Correo: `gmail` mientras no haya dominio, `resend` cuando exista y esté verificado.
MAIL_PROVIDER="gmail"
MAIL_FROM="PartOps <partopsgt@gmail.com>"
GMAIL_USER="partopsgt@gmail.com"
GMAIL_APP_PASSWORD=""
RESEND_API_KEY=""

# Archivos: R2 en producción, disco local en desarrollo.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="partops"
R2_PUBLIC_URL=""

# Antibots
TURNSTILE_SECRET_KEY=""

# Keepalive / cron
CRON_SECRET=""

# Push (FCM)
FIREBASE_SERVICE_ACCOUNT=""

# Observabilidad
SENTRY_DSN=""

# ---------- Web ----------
API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
NEXT_PUBLIC_SENTRY_DSN=""
