{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "DIRECT_DATABASE_URL"],
  "globalPassThroughEnv": [
    "SMOKE_BASE_URL",
    "SMOKE_API_URL",
    "SMOKE_EXPECTED_COMMIT",
    "SMOKE_TIMEOUT_MS",
    "BACKUP_DATABASE_URL",
    "SCRATCH_DATABASE_URL",
    "SOURCE_DATABASE_URL",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET",
    "RENDER_API_KEY",
    "RENDER_PLAN",
    "RENDER_REGION",
    "RENDER_HAS_PAYMENT",
    "RENDER_GITHUB_APP_OK",
    "OWNER_ID",
    "REPO_URL",
    "REPO_BRANCH",
    "BETTER_AUTH_SECRET",
    "CRON_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".open-next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
